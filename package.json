{
  "name": "sajawal-pos",
  "version": "2.0.0",
  "description": "Sajawal POS — offline point of sale, inventory and udhaar ledger for beauty & cosmetics retail",
  "main": "main.js",
  "private": true,
  "author": "Sajawal POS",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/services.test.js",
    "smoke": "electron scripts/smoke.js",
    "print-check": "electron scripts/print-check.js",
    "icons": "node scripts/build-icons.js && electron scripts/make-icon.js",
    "dist": "npm test && electron-builder --win nsis portable --x64",
    "dist:installer": "npm test && electron-builder --win nsis --x64",
    "dist:portable": "npm test && electron-builder --win portable --x64"
  },
  "engines": {
    "node": ">=22.12"
  },
  "build": {
    "appId": "com.sajawal.pos",
    "productName": "Sajawal POS",
    "copyright": "Copyright © 2026 Sajawal POS",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "package.json",
      "src/**/*",
      "css/**/*",
      "js/**/*",
      "assets/**/*",
      "build/icon.png"
    ],
    "asar": true,
    "win": {
      "icon": "build/icon.ico",
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Sajawal POS",
      "deleteAppDataOnUninstall": false,
      "artifactName": "Sajawal-POS-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Sajawal-POS-Portable-${version}.${ext}"
    }
  },
  "devDependencies": {
    "electron": "43.3.0",
    "electron-builder": "^26.15.3"
  }
}
